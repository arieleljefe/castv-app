<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_mini_player"
    android:elevation="8dp"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/nowThumbBox"
            android:layout_width="56dp"
            android:layout_height="42dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_thumb"
            android:clipToOutline="true"
            android:visibility="gone">

            <ImageView
                android:id="@+id/nowIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_audio"
                android:tint="@color/vlc_muted" />

            <ImageView
                android:id="@+id/nowThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvNowPlaying"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Ningún archivo seleccionado"
            android:textColor="@color/vlc_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnNowFav"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="☆"
            android:textColor="@color/vlc_muted"
            android:textSize="22sp" />

        <ImageButton
            android:id="@+id/btnQuick"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Reproducir o pausar"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play_w" />

        <ImageButton
            android:id="@+id/btnExpand"
            android:layout_width="36dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Mostrar controles"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_expand" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/seekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:enabled="false"
        android:max="100"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:progressBackgroundTint="#555555"
        android:progressTint="@color/accent"
        android:thumbTint="@color/accent" />

    <LinearLayout
        android:id="@+id/playerExpanded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvElapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="0:00"
            android:textColor="@color/vlc_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="--:--"
            android:textColor="@color/vlc_muted"
            android:textSize="12sp" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBack10"
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="−10"
            android:textAllCaps="false"
            android:textColor="@color/vlc_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnMute"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Silencio"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_vol_on" />

        <SeekBar
            android:id="@+id/volSeek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progressBackgroundTint="#555555"
            android:progressTint="@color/accent"
            android:thumbTint="@color/accent" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnFwd10"
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="+10"
            android:textAllCaps="false"
            android:textColor="@color/vlc_text"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnShuffle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Mezclar"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_shuffle" />

        <ImageButton
            android:id="@+id/btnPrev"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Anterior"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_prev" />

        <ImageButton
            android:id="@+id/btnPause"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Pausa"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_pause" />

        <ImageButton
            android:id="@+id/btnPlay"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/ctrl_play"
            android:contentDescription="Reproducir"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play" />

        <ImageButton
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Detener"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_stop" />

        <ImageButton
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Siguiente"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_next" />

        <ImageButton
            android:id="@+id/btnAuto"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/ctrl_off"
            android:contentDescription="Auto-avance"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_repeat" />
    </LinearLayout>
    </LinearLayout>
</LinearLayout>
