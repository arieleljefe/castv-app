<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vlc_bg"
    android:orientation="vertical">

    <!-- Barra superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▲"
            android:textColor="?attr/castvAccent"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="CASTV"
            android:textColor="@color/vlc_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text=""
            android:textColor="?attr/castvAccent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- [INCOG-2] Aviso visible del modo incógnito (solo aparece con el modo activado) -->
        <TextView
            android:id="@+id/tvIncog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:contentDescription="Modo incógnito activado"
            android:text="🕵️‍♂️"
            android:textSize="18sp"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnSearch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Buscar"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_search" />

        <ImageButton
            android:id="@+id/btnOutput"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Salida de música"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_tv" />

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Más opciones"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_more_vert_w" />
    </LinearLayout>

    <!-- Buscador (aparece al tocar la lupa) -->
    <LinearLayout
        android:id="@+id/searchBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search"
            android:hint="Buscar..."
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="@color/vlc_text"
            android:textColorHint="@color/vlc_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnClearSearch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/vlc_muted"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Pestañas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tabAll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/tab_off"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="PISTAS"
            android:textColor="@color/vlc_muted"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabFavs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/tab_off"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="FAVORITOS"
            android:textColor="@color/vlc_muted"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabResume"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/tab_off"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="CONTINUAR"
            android:textColor="@color/vlc_muted"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Filtro activo (carpeta / artista / álbum / lista): al tocarlo se quita -->
    <TextView
        android:id="@+id/tvFilter"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_chip"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="?attr/castvAccent"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp"
        android:text="Buscando TV en la red..."
        android:textColor="@color/vlc_muted"
        android:textSize="12sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/listFiles"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/vlc_bg"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"
            android:footerDividersEnabled="false"
            android:headerDividersEnabled="false"
            android:paddingBottom="72dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:padding="32dp"
            android:textColor="@color/vlc_muted"
            android:textSize="15sp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/fabShuffle"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:background="@drawable/ctrl_play"
            android:contentDescription="Mezclar y reproducir"
            android:elevation="6dp"
            android:padding="15dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_shuffle"
            android:tint="#0B0F14" />
    </FrameLayout>

    <include layout="@layout/player_bar" />

    <!-- Navegación inferior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/bg_bottom_nav"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/navVideo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:drawablePadding="2dp"
            android:drawableTint="@color/vlc_muted"
            android:drawableTop="@drawable/ic_nav_video"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingTop="8dp"
            android:paddingEnd="4dp"
            android:paddingBottom="6dp"
            android:text="Video"
            android:textColor="@color/vlc_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/navAudio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:drawablePadding="2dp"
            android:drawableTint="@color/vlc_muted"
            android:drawableTop="@drawable/ic_nav_audio"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingTop="8dp"
            android:paddingEnd="4dp"
            android:paddingBottom="6dp"
            android:text="Audio"
            android:textColor="@color/vlc_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/navFolders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:drawablePadding="2dp"
            android:drawableTint="@color/vlc_muted"
            android:drawableTop="@drawable/ic_nav_channels"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingTop="8dp"
            android:paddingEnd="4dp"
            android:paddingBottom="6dp"
            android:text="Canales"
            android:textColor="@color/vlc_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/navQueue"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:drawablePadding="2dp"
            android:drawableTint="@color/vlc_muted"
            android:drawableTop="@drawable/ic_nav_queue"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingTop="8dp"
            android:paddingEnd="4dp"
            android:paddingBottom="6dp"
            android:text="Cola"
            android:textColor="@color/vlc_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/navMore"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:drawablePadding="2dp"
            android:drawableTint="@color/vlc_muted"
            android:drawableTop="@drawable/ic_nav_more"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingTop="8dp"
            android:paddingEnd="4dp"
            android:paddingBottom="6dp"
            android:text="Más"
            android:textColor="@color/vlc_muted"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
