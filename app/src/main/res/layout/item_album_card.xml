<?xml version="1.0" encoding="utf-8"?>
<!-- [ALBUMES-2] Tarjeta de un álbum: carátula cuadrada, título y artista -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/item_bg"
    android:clickable="true"
    android:orientation="vertical"
    android:padding="6dp">

    <FrameLayout
        android:id="@+id/albCover"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="@drawable/bg_thumb"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/albIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:padding="44dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mas_album" />

        <ImageView
            android:id="@+id/albThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/albTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/vlc_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/albSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/vlc_muted"
        android:textSize="12sp" />
</LinearLayout>
