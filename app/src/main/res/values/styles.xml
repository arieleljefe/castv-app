<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Castv" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">?attr/castvAccent</item>
        <item name="colorPrimaryDark">?attr/castvBg</item>
        <item name="colorAccent">?attr/castvAccent</item>
        <item name="castvAccent">@color/accent_cyan</item>
        <item name="castvAccentSoft">@color/accent_cyan_soft</item>
        <item name="castvPlayingBg">@color/accent_cyan_bg</item>
        <!-- [TEMAS-2] fondos por defecto (los de siempre); BgOverlay* los cambian en modo oscuro -->
        <item name="castvBg">@color/vlc_bg</item>
        <item name="castvSurface">@color/vlc_surface</item>
        <item name="castvSurface2">@color/vlc_surface2</item>
        <item name="castvNav">@color/vlc_nav</item>
        <item name="castvStroke">@color/vlc_stroke</item>
        <!-- [FONDO-IMG-1] -->
        <item name="castvRootBg">?attr/castvBg</item>
        <!-- [TEMAS-3a] formas por defecto (las de siempre); ShapeOverlay* las cambian -->
        <item name="castvRadiusThumb">10dp</item>
        <item name="castvRadiusChip">18dp</item>
        <item name="castvRadiusSearch">22dp</item>
        <item name="castvRadiusDialog">20dp</item>
        <item name="android:windowBackground">?attr/castvBg</item>
        <item name="android:statusBarColor">?attr/castvBg</item>
        <item name="android:navigationBarColor">?attr/castvSurface</item>
        <!-- [PULIDO-1] Todos los AlertDialog de la app usan el estilo de abajo -->
        <item name="alertDialogTheme">@style/ThemeOverlay.Castv.Dialog</item>
    </style>
    <style name="ThemeOverlay.Castv.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:colorBackgroundFloating">?attr/castvSurface</item>
        <item name="colorSurface">?attr/castvSurface</item>
        <item name="colorOnSurface">@color/vlc_text</item>
        <item name="android:textColorPrimary">@color/vlc_text</item>
        <item name="android:textColorSecondary">@color/vlc_muted</item>
    </style>
    <style name="AccentOverlayCyan">
        <item name="castvAccent">@color/accent_cyan</item>
        <item name="castvAccentSoft">@color/accent_cyan_soft</item>
        <item name="castvPlayingBg">@color/accent_cyan_bg</item>
    </style>
