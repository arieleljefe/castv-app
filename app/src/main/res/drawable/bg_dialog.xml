<?xml version="1.0" encoding="utf-8"?>
<!-- [PULIDO-1] Fondo de los cuadros de diálogo: la superficie de la app con borde fino y esquinas redondeadas.
     El inset de 16dp es el mismo margen que usa el diálogo estándar de AppCompat. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="16dp"
    android:insetTop="16dp"
    android:insetRight="16dp"
    android:insetBottom="16dp">
    <shape android:shape="rectangle">
        <solid android:color="?attr/castvSurface"/>
        <stroke android:width="1dp" android:color="?attr/castvStroke"/>
        <corners android:radius="?attr/castvRadiusDialog"/>
    </shape>
</inset>
